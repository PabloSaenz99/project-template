root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = false
trim_trailing_whitespace = true

[*.{java,kt,kts}]
indent_style = tab
indent_size = 4

[*.{ts,tsx,html,css,scss}]
indent_style = tab
indent_size = 4

[*.{json,md,xml}]
indent_style = tab
indent_size = 4

[*.{yaml,yml}]
indent_style = tab
indent_size = 2

[*.sh]
indent_style = tab
indent_size = 4